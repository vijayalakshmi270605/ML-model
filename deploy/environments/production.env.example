# Production environment. Every blank field below is a secret or
# environment-specific value that is NEVER committed here — see
# docs/deployment.md §Secrets management. `core.config.Settings`'s own
# validator (`_validate_production_secrets`) refuses to start at all with
# APP_ENV=prod if SECRET_KEY is still its insecure default, or if
# API_KEY_REQUIRED=true and API_KEY is unset — a misconfigured production
# deployment fails loudly at startup, not silently at the first request.

# --- Application ---
APP_NAME=ad-mri
APP_ENV=prod
DEBUG=false
API_V1_PREFIX=/api/v1
# The real production frontend origin(s) — never a wildcard.
ALLOWED_ORIGINS=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Security ---
SECRET_KEY=
API_KEY_REQUIRED=true
API_KEY=
API_KEY_HEADER_NAME=X-API-Key

# --- Database (PostgreSQL) ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ad_mri
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT_SECONDS=5
AUDIT_ENABLED=true

# --- MLflow ---
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_STAGE=Production

# --- Inference engine ---
# The exact, already-validated-in-staging model version this deployment
# pins — see docs/deployment.md "Versioned model artifacts" / "Rollback
# capability". Never point this at a path that could change out from under a
# running deployment (e.g. a "latest" symlink) — pin an immutable, versioned
# artifact URI.
INFERENCE_MODEL_PATH=
INFERENCE_PREPROCESSING_CONFIG_PATH=configs/preprocessing/default.yaml
INFERENCE_CALIBRATION_CONFIG_PATH=
INFERENCE_DEVICE=auto
INFERENCE_TIMEOUT_SECONDS=30.0
INFERENCE_EXPLANATION_BACKGROUND_MANIFEST=
INFERENCE_EXPLANATION_OUTPUT_DIR=artifacts/explanations

# --- Redis / Celery ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Filesystem ---
CONFIG_DIR=configs
DATA_DIR=data

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=200
