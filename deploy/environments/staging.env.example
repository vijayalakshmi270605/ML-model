# Staging environment — a production-like environment for validating a
# release candidate before it is promoted to production (see
# docs/deployment.md "development → staging → production"). Every blank
# field below is a secret or environment-specific value that is NEVER
# committed here — see docs/deployment.md §Secrets management.

# --- Application ---
APP_NAME=ad-mri
APP_ENV=staging
DEBUG=false
API_V1_PREFIX=/api/v1
# The staging frontend/QA-tooling origin(s) allowed to call this API.
ALLOWED_ORIGINS=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Security ---
SECRET_KEY=
# Staging mirrors production's auth posture — a release candidate that only
# works with API_KEY_REQUIRED=false has not actually been validated.
API_KEY_REQUIRED=true
API_KEY=
API_KEY_HEADER_NAME=X-API-Key

# --- Database (PostgreSQL) ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ad_mri
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT_SECONDS=5
AUDIT_ENABLED=true

# --- MLflow ---
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_STAGE=Staging

# --- Inference engine ---
# The exact model version being validated before a production promotion —
# see docs/deployment.md "Versioned model artifacts".
INFERENCE_MODEL_PATH=
INFERENCE_PREPROCESSING_CONFIG_PATH=configs/preprocessing/default.yaml
INFERENCE_CALIBRATION_CONFIG_PATH=
INFERENCE_DEVICE=auto
INFERENCE_TIMEOUT_SECONDS=30.0
INFERENCE_EXPLANATION_BACKGROUND_MANIFEST=
INFERENCE_EXPLANATION_OUTPUT_DIR=artifacts/explanations

# --- Redis / Celery ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Filesystem ---
CONFIG_DIR=configs
DATA_DIR=data

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=200
