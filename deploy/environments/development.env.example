# Deployed development environment (a shared dev host/cluster running the real
# containers — distinct from a laptop running `ad-mri serve` directly, which
# uses ../../.env.example instead). See README.md in this directory.
#
# Every blank field below is a secret or environment-specific value that is
# NEVER committed here — see docs/deployment.md §Secrets management.

# --- Application ---
APP_NAME=ad-mri
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
# The dev frontend/tooling origin(s) allowed to call this API from a browser.
ALLOWED_ORIGINS=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
# false in every deployed (containerized) environment — auto-reload is a
# laptop-only convenience (../../.env.example sets it true for that case).
API_RELOAD=false

# --- Logging ---
LOG_LEVEL=DEBUG
# json in every deployed environment (including dev) for consistent
# aggregator ingestion — console is only for an interactive laptop terminal.
LOG_FORMAT=json

# --- Security ---
# Supplied by the deployment platform's secret store — see docs/deployment.md
# §Secrets management. Never a real value here.
SECRET_KEY=
# Dev stays open by default so early integration testing isn't blocked on
# key provisioning; flip to true once real clients exist.
API_KEY_REQUIRED=false
API_KEY=
API_KEY_HEADER_NAME=X-API-Key

# --- Database (PostgreSQL) ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ad_mri
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT_SECONDS=5
AUDIT_ENABLED=true

# --- MLflow ---
# This environment's tracking server, e.g. http://mlflow.dev.internal:5000
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_STAGE=Staging

# --- Inference engine ---
# Which checkpoint this environment serves — an object-storage/filesystem URI
# (see storage.object_storage), never a path assumed to exist on the host.
INFERENCE_MODEL_PATH=
INFERENCE_PREPROCESSING_CONFIG_PATH=configs/preprocessing/default.yaml
INFERENCE_CALIBRATION_CONFIG_PATH=
INFERENCE_DEVICE=auto
INFERENCE_TIMEOUT_SECONDS=30.0
INFERENCE_EXPLANATION_BACKGROUND_MANIFEST=
INFERENCE_EXPLANATION_OUTPUT_DIR=artifacts/explanations

# --- Redis / Celery ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Filesystem ---
CONFIG_DIR=configs
DATA_DIR=data

# --- Rate limiting --- (generous in dev, to avoid blocking integration testing)
RATE_LIMIT_PER_MINUTE=120

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=200
