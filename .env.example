# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. This example file must never contain a real secret.

# --- Application ---
APP_NAME=ad-mri
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Logging ---
LOG_LEVEL=INFO
# console | json  (use json in staging/prod for log-aggregator ingestion)
LOG_FORMAT=console

# --- Security ---
# Generate a real value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-me
API_KEY_REQUIRED=false
# The legacy single key — a superuser holding every scope (api.deps.require_scope).
# Leave blank and use API_KEYS below instead for real multi-key authorization.
API_KEY=
API_KEY_HEADER_NAME=X-API-Key
# Authorization architecture (Phase 14, docs/security.md): multiple keys,
# each with its own scopes ("predict" | "label" — core.constants.ApiScope).
# A JSON object; blank (the default) means "not configured" — falls back
# entirely to the single API_KEY above. Example:
#   API_KEYS={"ingestion-pipeline-key": ["predict"], "clinician-key": ["predict", "label"]}
API_KEYS=

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL directly, or leave it blank and configure the components below.
# See docs/database.md for the audit-trail schema this connects to.
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ad_mri
# Connection-pool sizing (db.session.build_engine) — applied only for a
# non-SQLite URL; see that function's docstring.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT_SECONDS=5
# Best-effort audit-trail persistence (api.audit) — an unreachable audit
# database never fails a /predictions or /explanations request. Set false to
# turn writes off entirely (e.g. a deployment with no database at all).
AUDIT_ENABLED=true

# --- MLflow ---
# Used by `ad-mri train` / `python -m ad_mri.training.train`. Blank (the default
# below) uses MLflow's own local file-store (./mlruns) — no server required.
# Point this at a real tracking server (e.g. http://localhost:5000) once you're
# running one; an unreachable server degrades gracefully (training still
# completes, MLflow logging is just skipped) rather than blocking the run.
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_STAGE=Production

# --- Inference engine ---
# Path to the checkpoint the API/standalone inference service serves. Blank
# (the default) means "not configured" — POST /api/v1/predictions responds
# 503 rather than crashing at startup.
INFERENCE_MODEL_PATH=
INFERENCE_PREPROCESSING_CONFIG_PATH=configs/preprocessing/default.yaml
INFERENCE_CALIBRATION_CONFIG_PATH=
INFERENCE_DEVICE=auto
INFERENCE_TIMEOUT_SECONDS=30.0
INFERENCE_EXPLANATION_BACKGROUND_MANIFEST=
INFERENCE_EXPLANATION_OUTPUT_DIR=artifacts/explanations

# --- Redis / Celery (async explainability jobs) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Filesystem (overridable — never hardcoded in code) ---
CONFIG_DIR=configs
DATA_DIR=data

# --- Rate limiting ---
# In-memory, per-process, per-client (API key if present, else source IP)
# sliding-window limiter (api.middleware.rate_limit). <= 0 disables it. For a
# multi-instance deployment, swap this for a shared (e.g. Redis-backed —
# REDIS_URL is already configured above) limiter; see docs/api.md.
RATE_LIMIT_PER_MINUTE=60

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=200

# --- LLM narrative summaries (optional, off by default) ---
# POST /explanations attaches a plain-language summary of the LIME/SHAP
# numeric output via the OpenAI API when this is set — leave blank (the
# default) to skip it entirely; the endpoint works identically either way.
# Only aggregate region-importance numbers are ever sent, never image data or
# a patient identifier — see explainability/llm_summary.py's module docstring.
# Requires the optional `llm` extra: pip install -e ".[llm]"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15.0
